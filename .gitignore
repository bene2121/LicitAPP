# Build / distribución
dist/
build/*.exe
build/*.ico

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.pyo
*.egg-info/
.eggs/

# Datos y bases de datos
data/
*.db
*.db-journal
*.sqlite

# Licencias y claves — NUNCA subir al repo
licencias/claves/privada.pem
licencias/claves/*.pem
!licencias/claves/publica.pem
*.key
*.p12
*.pfx
.smtp_secret
.lic_cache
.trial
licencias/mi_licencia.lic
licencias/licencias_generadas/
*.lic

# Temporales y logs de licencias
licencias/test.tmp
licencias/*.tmp

# Entorno
.env
.venv/
venv/
env/

# Cache de herramientas
.pytest_cache/
error.txt

# Capturas del bot
data/capturas/

# Superpowers (repo externo clonado)
superpowers/

# Expedientes reales: documentos privados del proponente, no se suben al repo
expedientes/*/*
!expedientes/*/LEEME.txt
expedientes/*/propuestas/

# Configuracion local de herramientas (rutas y permisos personales) y secretos de Streamlit
.claude/settings.local.json
.streamlit/secrets.toml
.env.*
!.env.example

# Registros del instalador
construir_e_instalar_log.txt
